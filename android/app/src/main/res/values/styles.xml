<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Shunshou.Button.Primary" parent="">
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Shunshou.Button.Secondary" parent="Shunshou.Button.Primary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/green</item>
    </style>

    <style name="Shunshou.Button.Text" parent="">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Shunshou.Label" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="Shunshou.Card" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="Shunshou.Input" parent="">
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
